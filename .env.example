# Never commit the real value. Generate it with:
# python -m honeypot.keygen
HONEYPOT_HOST_KEY_B64=PASTE_ONE_LINE_BASE64_KEY_HERE

HONEYPOT_PUBLIC_BIND=127.0.0.1
HONEYPOT_PUBLIC_PORT=2222
HONEYPOT_HOSTNAME=server01

# Production accepts sha256 or redact; plain is available in development only.
HONEYPOT_CREDENTIAL_LOG_MODE=sha256
HONEYPOT_ALERT_MIN_RISK=65
HONEYPOT_INTELLIGENCE_ENABLED=true
HONEYPOT_IOC_ENABLED=true
HONEYPOT_LOG_HASHING=true
HONEYPOT_MAX_SESSION_HISTORY=500
HONEYPOT_MAX_SCORE=1000

HONEYPOT_MAX_CONNECTIONS=64
HONEYPOT_MAX_CONNECTIONS_PER_IP=4
HONEYPOT_LISTEN_BACKLOG=128
HONEYPOT_BANNER_TIMEOUT=12
HONEYPOT_AUTH_TIMEOUT=20
HONEYPOT_CHANNEL_TIMEOUT=20
HONEYPOT_REQUEST_TIMEOUT=10
HONEYPOT_CHANNEL_IO_TIMEOUT=30
HONEYPOT_GLOBAL_RATE_PER_MINUTE=120
HONEYPOT_GLOBAL_RATE_BURST=30
HONEYPOT_IP_RATE_PER_MINUTE=12
HONEYPOT_IP_RATE_BURST=4
HONEYPOT_IDLE_TIMEOUT=90
HONEYPOT_MAX_SESSION_SECONDS=900

HONEYPOT_COMMAND_DELAY_MIN=0.1
HONEYPOT_COMMAND_DELAY_MAX=1.0
HONEYPOT_MAX_LINE_LENGTH=4096
HONEYPOT_MAX_COMMANDS=500
HONEYPOT_MAX_CHAIN_COMMANDS=32
HONEYPOT_HISTORY_LIMIT=200
HONEYPOT_MAX_OUTPUT_BYTES=65536
HONEYPOT_MAX_PACKAGES=256

HONEYPOT_VFS_MAX_NODES=2048
HONEYPOT_VFS_MAX_TOTAL_BYTES=2097152
HONEYPOT_VFS_MAX_FILE_BYTES=131072
HONEYPOT_VFS_MAX_PATH_LENGTH=512
HONEYPOT_VFS_MAX_NAME_LENGTH=255
HONEYPOT_VFS_MAX_QUERY_RESULTS=512

HONEYPOT_LOG_QUEUE_SIZE=10000
HONEYPOT_LOG_FIELD_LIMIT=4096

HONEYPOT_MEMORY_LIMIT=384m
HONEYPOT_MEMORY_RESERVATION=128m
HONEYPOT_CPU_LIMIT=0.75
